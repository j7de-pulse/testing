# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=
# Optional: register /usd in one server instantly instead of globally
GUILD_ID=
# Your Discord user ID (Developer Mode -> right-click yourself -> Copy User ID). Only this ID can use -vault.
OWNER_ID=
# Stripe secret key (sk_live_... or sk_test_...). Never commit this.
STRIPE_SECRET_KEY=
# Where Stripe sends the payer after checkout
SUCCESS_URL=https://discord.com/channels/@me
CANCEL_URL=https://discord.com/channels/@me
# ER:LC server finder storage. On Railway, mount a volume at /data and set this to /data/finder.json
FINDER_DATA_PATH=data/finder.json
